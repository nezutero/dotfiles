# Appearance (colors)
set default-bg                  "#1c1c1c"
set default-fg                  "#cccccc"
set notification-error-bg       "#1c1c1c"
set notification-error-fg       "#fb4934"
set notification-warning-bg     "#1c1c1c"
set notification-warning-fg     "#d4be98"
set notification-bg             "#1c1c1c"
set notification-fg             "#d4be98"
set completion-bg               "#222222"
set completion-fg               "#cccccc"
set completion-group-bg         "#1c1c1c"
set completion-group-fg         "#aaaaaa"
set completion-highlight-bg     "#d4be98"
set completion-highlight-fg     "#222222"
set index-bg                    "#222222"
set index-fg                    "#cccccc"
set index-active-bg             "#d4be98"
set index-active-fg             "#222222"
set inputbar-bg                 "#1c1c1c"
set inputbar-fg                 "#cccccc"
set statusbar-bg                "#1c1c1c"
set statusbar-fg                "#cccccc"
set highlight-color             "rgba(212,190,152,0.30)"
set highlight-active-color      "rgba(254,128,25,0.30)"
set render-loading              true
set render-loading-bg           "#1c1c1c"
set render-loading-fg           "#cccccc"
set recolor-lightcolor          "#1c1c1c"
set recolor-darkcolor           "#cccccc"

# Reader behavior
set recolor                     true
set recolor-keephue             true
set selection-clipboard         clipboard
set pages-per-row               1
set scroll-step                 50
set adjust-open                 best-fit
set continuous-hist-save        true
set synctex                     true

# Zoom/fit settings
set zoom-min                    10
set zoom-max                    1000
set zoom-step                   10

# Keybindings
map n navigate next
map p navigate previous
map <Right> navigate next
map <Left> navigate previous
map <Down> scroll down
map <Up> scroll up
map <space> navigate next
map b navigate previous
map <C-Right> navigate next
map <C-Left> navigate previous

# Mouse wheel navigation
map <Button4> scroll up
map <Button5> scroll down

# Utility commands
map R reload
map a adjust_window best-fit
map s adjust_window width
map <C-i> zoom in
map <C-o> zoom out
map r rotate
map <F11> toggle_fullscreen
