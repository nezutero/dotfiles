set $mod Mod4
set $term kitty
set $browser zen-beta
set $fileManager yazi
set $menu rofi -show drun
set $player kitty --title rmpc -e sh -c "rmpc update && rmpc"

output eDP-1 resolution 1920x1080@60Hz position 0,0 scale 1.25
output eDP-1 bg ~/walls/your_name_sky1.jpg fill

seat seat0 xcursor_theme Adwaita 24

exec waybar
exec hypridle
exec dunst -config ~/.config/dunst/dunstrc
exec clipmenud
exec ~/dotfiles/scripts/battery_notify.sh
exec wlsunset -t "4000" -T "4500"
exec wl-paste --type text --watch cliphist store
exec wl-paste --type image --watch cliphist store

bar {
    mode visible
}

# ── INPUT ─────────────────────────────────────────────────────────────
input "type:keyboard" {
    xkb_layout "us,ca"
    xkb_options "caps:escape,grp:alt_space_toggle"
}

input "type:touchpad" {
    tap enabled
    natural_scroll enabled
    pointer_accel -0.1
}

input "type:pointer" {
    pointer_accel -0.1
}

focus_follows_mouse yes

bindgesture swipe:3:right workspace prev
bindgesture swipe:3:left workspace next

# ── GENERAL / APPEARANCE ─────────────────────────────────────────────
# Corner radius needs nonzero gaps to actually be visible (SwayFX draws
# rounding within the gap area), so bumped up slightly from Hyprland's
# gaps_in/out = 0. Set both back to 0 if you'd rather keep it flush and
# drop corner_radius below to 0 as well.
gaps inner 0
gaps outer 0

default_border pixel 0
default_floating_border pixel 0

client.focused          #33ccff #33ccff #ffffff #00ff99 #33ccff
client.focused_inactive #595959 #595959 #ffffff #595959 #595959
client.unfocused        #595959 #595959 #ffffff #595959 #595959
client.urgent           #9b0000 #9b0000 #ffffff #9b0000 #9b0000

# ── SwayFX effects (equivalent to Hyprland's decoration {} + animations {}) ──
# Blur — matches your Hyprland decoration.blur { size 3 passes 1 }
blur enable
blur_xray disable
blur_passes 1
blur_radius 3

# Rounded corners (Hyprland config didn't set these, added since SwayFX
# makes them essentially free — set corner_radius 0 to skip this entirely)
smart_corner_radius enable
corner_radius 8

# Drop shadows (optional extra — SwayFX-only, no Hyprland equivalent existed
# in your original config; comment out `shadows enable` if not wanted)
shadows enable
shadow_blur_radius 20
shadow_color #00000070

# Dim unfocused windows slightly
default_dim_inactive 0.15

# Blur/round bar and launcher popups too
layer_effects "waybar" { blur enable; corner_radius 8; }
layer_effects "rofi" { blur enable; corner_radius 8; }

floating_modifier $mod normal

# ── KEYBINDS ──────────────────────────────────────────────────────────
bindsym $mod+Return exec $term
bindsym $mod+F      exec $browser
bindsym $mod+W      kill
bindsym $mod+E      exec $term -e $fileManager
bindsym $mod+B      exec rofi-bluetooth
bindsym $mod+H      exec ~/dotfiles/scripts/youtube-mpv.sh
bindsym $mod+R      exec ~/dotfiles/scripts/zathura_rofi.sh
bindsym $mod+N      exec kitty -d ~/notes

bindsym $mod+space exec $menu
bindsym $mod+P exec ~/dotfiles/scripts/rofipass.sh
bindsym $mod+C exec cliphist list | rofi -dmenu | cliphist decode | wl-copy
bindsym $mod+A exec audacity
bindsym $mod+S exec $player
bindsym $mod+D exec vesktop
bindsym $mod+G exec signal-desktop

bindsym $mod+M exec waybar
bindsym $mod+K exec pkill waybar

bindsym $mod+L exec swaylock

# --- Focus movement ---
bindsym $mod+Left  focus left
bindsym $mod+Right focus right
bindsym $mod+Up    focus up
bindsym $mod+Down  focus down

# --- Workspaces ---
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10

bindsym $mod+Tab workspace back_and_forth

bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10

# Scroll to change workspace (Hyprland's mainMod + mouse_down/up)
bindsym --whole-window $mod+button4 workspace prev
bindsym --whole-window $mod+button5 workspace next

bindsym Print exec grim -g "$(slurp)" - | wl-copy -t image/png && \
    dunstify -a "Screenshot" -u low -r 9001 -t 1500 "Screenshot" "Copied to clipboard"

bindsym $mod+Print exec FILE=~/Pictures/screenshots/$(date +%Y-%m-%d-%H-%M-%S).png && \
    grim -g "$(slurp)" "$FILE" && \
    dunstify -a "Screenshot" -u low -r 9002 -t 1500 "Screenshot Saved" "$FILE"

# --- Media / brightness keys ---
bindsym --locked XF86MonBrightnessUp   exec ~/dotfiles/scripts/backlight.sh up
bindsym --locked XF86MonBrightnessDown exec ~/dotfiles/scripts/backlight.sh down
bindsym $mod+XF86MonBrightnessUp   exec ~/dotfiles/scripts/backlight.sh max
bindsym $mod+XF86MonBrightnessDown exec ~/dotfiles/scripts/backlight.sh min
bindsym Ctrl+XF86MonBrightnessUp   exec ~/dotfiles/scripts/temperature.sh up
bindsym Ctrl+XF86MonBrightnessDown exec ~/dotfiles/scripts/temperature.sh down

bindsym --locked XF86AudioRaiseVolume exec wpctl set-volume -l 1.4 @DEFAULT_AUDIO_SINK@ 5%+
bindsym --locked XF86AudioLowerVolume exec wpctl set-volume -l 1.4 @DEFAULT_AUDIO_SINK@ 5%-
bindsym --locked XF86AudioMute        exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym --locked XF86AudioMicMute     exec wpctl set-mute @DEFAULT_SOURCE@ toggle

bindsym XF86Favorites exec rofi -show power-menu -modi power-menu:~/dotfiles/scripts/rofi-power-menu.sh
bindsym XF86Tools     exec kitty -d ~/dotfiles -e nvim .

include /etc/sway/config.d/*
